<%- include('./partials/header') %>

<div class="w-full min-h-screen flex flex-col items-center justify-center px-6 py-20 text-center">
    <div class="max-w-lg bg-white p-10 rounded-lg shadow-md border">
        <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">
            <i class="ri-error-warning-line"></i>
        </div>

        <h1 class="text-4xl font-extrabold text-gray-900 mb-2">
            <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
        </h1>
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Oops! An error occurred</h2>

        <p class="text-gray-600 mb-6 text-sm">
            <%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your request.' %>
        </p>

        <% if (typeof stack !== 'undefined' && stack) { %>
            <div class="text-left bg-gray-900 text-green-400 p-4 rounded text-xs font-mono overflow-x-auto max-h-48 mb-6">
                <pre><%= stack %></pre>
            </div>
        <% } %>

        <a href="/"
           class="inline-block px-6 py-3 bg-[#3f2a1d] text-white rounded-md font-semibold hover:bg-[#2b1c13] transition">
            Go back home
        </a>
    </div>
</div>

<%- include('./partials/footer') %>
