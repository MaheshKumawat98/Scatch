<%- include('./partials/header') %>

<div class="w-full min-h-screen px-20 py-16 flex flex-col items-center">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="mb-6 p-4 rounded-md bg-green-500 text-white w-full max-w-5xl">
            <%= success %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="mb-6 p-4 rounded-md bg-red-500 text-white w-full max-w-5xl">
            <%= error %>
        </div>
    <% } %>

    <div class="w-full max-w-5xl">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold">My Orders</h1>
            <a href="/shop" class="text-sm font-semibold text-amber-700 hover:underline">Continue Shopping &rarr;</a>
        </div>

        <% if (!orders || orders.length === 0) { %>
            <div class="w-full bg-white p-12 text-center rounded-md shadow-md">
                <i class="ri-shopping-bag-line text-6xl text-gray-300 mb-4 inline-block"></i>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">You haven't placed any orders yet</h3>
                <p class="text-gray-500 mb-6">Explore our curated collections and place your first order.</p>
                <a href="/shop" class="px-6 py-3 bg-[#3f2a1d] text-white rounded-md font-semibold hover:bg-[#2b1c13]">
                    Explore Shop
                </a>
            </div>
        <% } else { %>
            <div class="space-y-6">
                <% orders.forEach(function(order) { %>
                    <div class="bg-white rounded-md shadow-md border overflow-hidden hover:shadow-lg transition">
                        <div class="p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-gray-50 border-b">
                            <div>
                                <span class="text-xs uppercase tracking-wider text-gray-500">Order ID</span>
                                <h3 class="font-mono text-sm font-bold text-gray-800">#<%= order._id %></h3>
                                <p class="text-xs text-gray-500 mt-1">
                                    Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                </p>
                            </div>
                            <div class="flex items-center gap-6">
                                <div>
                                    <span class="text-xs uppercase tracking-wider text-gray-500">Total</span>
                                    <p class="text-lg font-bold text-gray-900">₹<%= order.totalAmount %></p>
                                </div>
                                <div>
                                    <span class="text-xs uppercase tracking-wider text-gray-500 block mb-1">Status</span>
                                    <% if (order.orderStatus === 'placed') { %>
                                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Placed</span>
                                    <% } else if (order.orderStatus === 'confirmed') { %>
                                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-indigo-100 text-indigo-800">Confirmed</span>
                                    <% } else if (order.orderStatus === 'shipped') { %>
                                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-purple-100 text-purple-800">Shipped</span>
                                    <% } else if (order.orderStatus === 'delivered') { %>
                                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Delivered</span>
                                    <% } else if (order.orderStatus === 'cancelled') { %>
                                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                                    <% } %>
                                </div>
                                <a href="/orders/<%= order._id %>"
                                   class="px-4 py-2 border border-gray-300 rounded-md text-sm font-semibold hover:bg-gray-100 text-gray-700">
                                    View Details &rarr;
                                </a>
                            </div>
                        </div>

                        <!-- Item thumbnails -->
                        <div class="p-6 flex items-center justify-between">
                            <div class="flex items-center gap-4 flex-wrap">
                                <% order.products.forEach(function(item) { %>
                                    <% if (item.product) { %>
                                        <div class="flex items-center gap-3">
                                            <% if (item.product.image) { %>
                                                <img class="w-14 h-14 object-cover rounded border"
                                                     src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>" alt="">
                                            <% } %>
                                            <div>
                                                <p class="text-sm font-medium text-gray-900"><%= item.product.name %></p>
                                                <p class="text-xs text-gray-500">Qty: <%= item.quantity %> &bull; ₹<%= item.priceAtPurchase %></p>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                            </div>
                            <span class="text-xs text-gray-500"><%= order.paymentMethod %></span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>
