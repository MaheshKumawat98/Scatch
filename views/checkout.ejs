<%- include('./partials/header') %>

<div class="w-full min-h-screen px-20 py-16 flex flex-col items-center">
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="mb-6 p-4 rounded-md bg-red-500 text-white w-full max-w-5xl">
            <%= error %>
        </div>
    <% } %>

    <div class="w-full max-w-5xl">
        <h1 class="text-3xl font-bold mb-8">Checkout</h1>

        <div class="flex flex-col md:flex-row gap-10 items-start">
            <!-- Left Column: Shipping Address & Payment Form -->
            <div class="w-full md:w-3/5 bg-white p-6 rounded-md shadow-md">
                <h2 class="text-xl font-semibold mb-6 pb-2 border-b">1. Shipping Details</h2>
                <form action="/orders/checkout" method="POST">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                            <input type="text" name="fullname" value="<%= user.fullname || '' %>" required
                                class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-amber-500 bg-gray-50">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" name="phone" value="<%= user.contact || '' %>" required
                                placeholder="10-digit mobile number"
                                class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-amber-500 bg-gray-50">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Street Address</label>
                        <input type="text" name="address" required placeholder="House / Flat no., street, landmark"
                            class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-amber-500 bg-gray-50">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
                            <input type="text" name="city" required
                                class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-amber-500 bg-gray-50">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
                            <input type="text" name="state" required
                                class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-amber-500 bg-gray-50">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Pincode</label>
                            <input type="text" name="pincode" required
                                class="w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-amber-500 bg-gray-50">
                        </div>
                    </div>

                    <h2 class="text-xl font-semibold mb-4 pt-4 border-t">2. Payment Method</h2>
                    <div class="space-y-3 mb-8">
                        <label class="flex items-center gap-3 p-3 border rounded-md cursor-pointer hover:bg-gray-50">
                            <input type="radio" name="paymentMethod" value="COD" checked class="text-amber-600 focus:ring-amber-500">
                            <div>
                                <span class="font-medium text-gray-900">Cash on Delivery (COD)</span>
                                <p class="text-xs text-gray-500">Pay cash upon delivery to your doorstep</p>
                            </div>
                        </label>
                        <label class="flex items-center gap-3 p-3 border rounded-md opacity-60 cursor-not-allowed bg-gray-100">
                            <input type="radio" name="paymentMethod" value="ONLINE" disabled class="text-gray-400">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-gray-700">Online Payment</span>
                                <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-semibold">Coming soon</span>
                            </div>
                        </label>
                    </div>

                    <button type="submit"
                        class="w-full py-3 bg-[#3f2a1d] text-white rounded-md text-lg font-semibold hover:bg-[#2b1c13] transition">
                        Confirm & Place Order (₹<%= totalAmount %>)
                    </button>
                </form>
            </div>

            <!-- Right Column: Read-Only Cart Summary & Total -->
            <div class="w-full md:w-2/5 bg-gray-50 p-6 rounded-md shadow-md border">
                <h2 class="text-xl font-semibold mb-4 pb-2 border-b">Order Summary</h2>

                <div class="space-y-4 max-h-80 overflow-y-auto mb-6 pr-2">
                    <% user.cart.forEach(function(item) { %>
                        <% if (item.product) { %>
                            <div class="flex items-center justify-between gap-3 pb-3 border-b border-gray-200">
                                <div class="flex items-center gap-3">
                                    <% if (item.product.image) { %>
                                        <img class="w-12 h-12 object-cover rounded"
                                             src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>" alt="">
                                    <% } %>
                                    <div>
                                        <h4 class="font-medium text-sm text-gray-900"><%= item.product.name %></h4>
                                        <p class="text-xs text-gray-500">Qty: <%= item.quantity %> × ₹<%= item.product.price %></p>
                                    </div>
                                </div>
                                <span class="font-semibold text-sm">₹<%= item.product.price * item.quantity %></span>
                            </div>
                        <% } %>
                    <% }) %>
                </div>

                <div class="space-y-2 text-sm text-gray-600 mb-6">
                    <div class="flex justify-between">
                        <span>Items Subtotal</span>
                        <span class="font-medium text-gray-800">₹<%= subtotal %></span>
                    </div>
                    <% if (discount > 0) { %>
                        <div class="flex justify-between text-green-600">
                            <span>Discount</span>
                            <span class="font-medium">-₹<%= discount %></span>
                        </div>
                    <% } %>
                    <div class="flex justify-between">
                        <span>Platform Fee</span>
                        <span class="font-medium text-gray-800">₹<%= platformFee %></span>
                    </div>
                    <div class="flex justify-between text-base font-bold text-gray-900 pt-3 border-t">
                        <span>Total Payable</span>
                        <span class="text-amber-800">₹<%= totalAmount %></span>
                    </div>
                </div>

                <a href="/cart" class="block text-center text-sm text-gray-500 hover:text-gray-800 underline">
                    Return to cart to modify items
                </a>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
