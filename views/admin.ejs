<%- include('./partials/header') %>

<div class="w-full min-h-screen flex items-start px-20 py-20">
    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-green-500 text-white z-50">
            <%= success %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-red-500 text-white z-50">
            <%= error %>
        </div>
    <% } %>

    <!-- Left Sidebar -->
    <div class="w-[20%] flex flex-col items-start pr-6 border-r">
        <h3 class="text-xl font-bold mb-6 text-gray-800">Admin Panel</h3>
        <div class="flex flex-col gap-3 w-full">
            <a class="block w-full px-3 py-2 rounded-md font-semibold text-gray-700 hover:bg-gray-100" href="/owners/products">
                All Products
            </a>
            <a class="block w-full px-3 py-2 rounded-md font-semibold text-gray-700 hover:bg-gray-100" href="/owners/products/create">
                Create New Product
            </a>
            <a class="block w-full px-3 py-2 rounded-md font-semibold text-gray-700 hover:bg-gray-100" href="/orders">
                View All Orders
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="w-[80%] flex flex-col gap-6 pl-10 min-h-screen">
        <div class="flex items-center justify-between pb-4 border-b">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Manage Inventory</h1>
                <p class="text-sm text-gray-500 mt-1">Total active items: <%= typeof products !== 'undefined' ? products.length : 0 %></p>
            </div>
            <a href="/owners/products/create"
               class="px-5 py-2.5 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition">
                + Create Product
            </a>
        </div>

        <% if (typeof products === 'undefined' || !products || products.length === 0) { %>
            <div class="p-12 text-center bg-gray-50 rounded-md border text-gray-500">
                <i class="ri-inbox-line text-5xl mb-2 inline-block"></i>
                <p class="text-lg font-medium">No products available in the catalog</p>
                <a href="/owners/products/create" class="mt-4 inline-block text-blue-600 font-semibold hover:underline">
                    Create the first product &rarr;
                </a>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% products.forEach(function(product) { %>
                    <div class="rounded-lg shadow border overflow-hidden flex flex-col justify-between">
                        <!-- Product Preview Card -->
                        <div>
                            <div class="w-full h-48 flex items-center justify-center bg-[<%= product.bgcolor || '#f3f4f6' %>]">
                                <% if (product.image) { %>
                                    <img class="h-40 object-contain"
                                         src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                         alt="<%= product.name %>">
                                <% } else { %>
                                    <div class="text-gray-400 text-sm">No Image</div>
                                <% } %>
                            </div>

                            <div class="p-4 bg-[<%= product.panelcolor || '#ffffff' %>] text-[<%= product.textcolor || '#1f2937' %>]">
                                <h3 class="text-lg font-bold truncate"><%= product.name %></h3>
                                <div class="flex items-center justify-between mt-2">
                                    <span class="text-base font-semibold">₹<%= product.price %></span>
                                    <% if (product.discount > 0) { %>
                                        <span class="text-xs px-2 py-0.5 rounded bg-green-100 text-green-800 font-semibold">
                                            ₹<%= product.discount %> off
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="p-4 bg-gray-50 border-t flex items-center justify-between">
                            <a href="/owners/products/<%= product._id %>/edit"
                               class="px-4 py-1.5 bg-amber-600 text-white rounded text-sm font-semibold hover:bg-amber-700 transition">
                                Edit
                            </a>

                            <form action="/owners/products/<%= product._id %>/delete" method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit"
                                        class="px-4 py-1.5 bg-red-600 text-white rounded text-sm font-semibold hover:bg-red-700 transition">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>