<%- include('./partials/header') %>

<div class="w-full min-h-screen px-20 py-16 flex flex-col items-center">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="mb-6 p-4 rounded-md bg-green-500 text-white w-full max-w-5xl">
            <%= success %>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="mb-6 p-4 rounded-md bg-red-500 text-white w-full max-w-5xl">
            <%= error %>
        </div>
    <% } %>

    <div class="w-full max-w-5xl">
        <div class="mb-6">
            <a href="/orders" class="text-sm font-semibold text-gray-500 hover:text-gray-800 flex items-center gap-1">
                &larr; Back to all orders
            </a>
        </div>

        <div class="bg-white rounded-md shadow-md border overflow-hidden">
            <!-- Header bar with ID, Date, Status, Cancel button -->
            <div class="p-6 bg-gray-50 border-b flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <span class="text-xs uppercase tracking-wider text-gray-500">Order Details</span>
                    <h1 class="text-xl font-mono font-bold text-gray-900">#<%= order._id %></h1>
                    <p class="text-xs text-gray-500 mt-1">
                        Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </p>
                </div>
                <div class="flex items-center gap-4">
                    <div>
                        <% if (order.orderStatus === 'placed') { %>
                            <span class="px-4 py-1.5 text-sm font-semibold rounded-full bg-blue-100 text-blue-800">Placed</span>
                        <% } else if (order.orderStatus === 'confirmed') { %>
                            <span class="px-4 py-1.5 text-sm font-semibold rounded-full bg-indigo-100 text-indigo-800">Confirmed</span>
                        <% } else if (order.orderStatus === 'shipped') { %>
                            <span class="px-4 py-1.5 text-sm font-semibold rounded-full bg-purple-100 text-purple-800">Shipped</span>
                        <% } else if (order.orderStatus === 'delivered') { %>
                            <span class="px-4 py-1.5 text-sm font-semibold rounded-full bg-green-100 text-green-800">Delivered</span>
                        <% } else if (order.orderStatus === 'cancelled') { %>
                            <span class="px-4 py-1.5 text-sm font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                        <% } %>
                    </div>

                    <% if (order.orderStatus === 'placed') { %>
                        <form action="/orders/<%= order._id %>/cancel" method="POST"
                              onsubmit="return confirm('Are you sure you want to cancel this order?');">
                            <button type="submit"
                                    class="px-4 py-2 bg-red-600 text-white rounded-md text-sm font-semibold hover:bg-red-700 transition">
                                Cancel Order
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>

            <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-8 border-b">
                <!-- Shipping Address -->
                <div class="md:col-span-2">
                    <h2 class="text-base font-semibold text-gray-900 mb-3">Delivery Address</h2>
                    <div class="p-4 rounded-md bg-gray-50 border text-sm text-gray-700 leading-relaxed">
                        <p class="font-bold text-gray-900"><%= order.shippingAddress.fullname %></p>
                        <p><%= order.shippingAddress.address %></p>
                        <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
                        <p class="mt-2 text-gray-600"><strong>Phone:</strong> <%= order.shippingAddress.phone %></p>
                    </div>
                </div>

                <!-- Payment Details -->
                <div>
                    <h2 class="text-base font-semibold text-gray-900 mb-3">Payment Info</h2>
                    <div class="p-4 rounded-md bg-gray-50 border text-sm text-gray-700 space-y-2">
                        <p><strong>Method:</strong> <%= order.paymentMethod === 'COD' ? 'Cash on Delivery' : 'Online Payment' %></p>
                        <p><strong>Payment Status:</strong>
                            <span class="capitalize font-semibold text-<%= order.paymentStatus === 'paid' ? 'green' : 'amber' %>-600">
                                <%= order.paymentStatus %>
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Ordered Products Table -->
            <div class="p-6">
                <h2 class="text-base font-semibold text-gray-900 mb-4">Items in this Order</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-gray-100 text-gray-700 uppercase text-xs font-semibold">
                            <tr>
                                <th class="p-3">Product</th>
                                <th class="p-3 text-center">Quantity</th>
                                <th class="p-3 text-right">Price at Purchase</th>
                                <th class="p-3 text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            <% order.products.forEach(function(item) { %>
                                <% if (item.product) { %>
                                    <tr>
                                        <td class="p-3 flex items-center gap-3">
                                            <% if (item.product.image) { %>
                                                <img class="w-12 h-12 object-cover rounded border"
                                                     src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>" alt="">
                                            <% } %>
                                            <span class="font-medium text-gray-900"><%= item.product.name %></span>
                                        </td>
                                        <td class="p-3 text-center text-gray-700"><%= item.quantity %></td>
                                        <td class="p-3 text-right text-gray-700">₹<%= item.priceAtPurchase %></td>
                                        <td class="p-3 text-right font-semibold text-gray-900">₹<%= item.priceAtPurchase * item.quantity %></td>
                                    </tr>
                                <% } %>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Price Breakdown -->
                <div class="mt-6 flex justify-end">
                    <div class="w-full md:w-1/3 space-y-2 text-sm text-gray-600 p-4 bg-gray-50 rounded-md border">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span class="font-medium text-gray-900">₹<%= order.subtotal %></span>
                        </div>
                        <% if (order.discount > 0) { %>
                            <div class="flex justify-between text-green-600">
                                <span>Discount</span>
                                <span class="font-medium">-₹<%= order.discount %></span>
                            </div>
                        <% } %>
                        <div class="flex justify-between">
                            <span>Platform Fee</span>
                            <span class="font-medium text-gray-900">₹<%= order.platformFee %></span>
                        </div>
                        <div class="flex justify-between text-base font-bold text-gray-900 pt-2 border-t">
                            <span>Total Amount</span>
                            <span class="text-amber-800">₹<%= order.totalAmount %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
