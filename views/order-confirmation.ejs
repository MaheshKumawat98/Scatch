<%- include('./partials/header') %>

<div class="w-full min-h-screen px-20 py-20 flex flex-col items-center justify-center text-center">
    <div class="max-w-md bg-white p-10 rounded-md shadow-md border">
        <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6 text-3xl">
            <i class="ri-checkbox-circle-fill"></i>
        </div>

        <h1 class="text-3xl font-bold text-gray-900 mb-2">Thank You!</h1>
        <p class="text-gray-600 mb-6">Your order has been placed successfully.</p>

        <div class="p-4 bg-gray-50 rounded-md border mb-8 text-sm">
            <span class="text-gray-500 block text-xs uppercase mb-1">Order ID</span>
            <span class="font-mono font-bold text-gray-800 text-base">#<%= orderId %></span>
        </div>

        <div class="flex flex-col gap-3">
            <a href="/orders/<%= orderId %>"
               class="w-full py-3 bg-[#3f2a1d] text-white rounded-md font-semibold hover:bg-[#2b1c13] transition">
                View Order Details
            </a>
            <a href="/shop"
               class="w-full py-2.5 border border-gray-300 text-gray-700 rounded-md font-semibold hover:bg-gray-50 transition">
                Continue Shopping
            </a>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
