<%- include('./partials/header') %>

<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-green-500 text-white z-50">
        <%= success %>
    </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-red-500 text-white z-50">
        <%= error %>
    </div>
<% } %>

<div class="min-h-screen flex flex-col">
    <div class="container px-10 py-20 flex flex-grow">
        <!-- Sidebar Navigation -->
        <div class="w-[25%] flex h-screen flex-col items-start pr-6 border-r">
            <h3 class="text-xl font-bold mb-6 text-gray-800">Admin Panel</h3>
            <div class="flex flex-col gap-3 w-full">
                <a class="block w-full px-3 py-2 rounded-md font-semibold text-gray-700 hover:bg-gray-100" href="/owners/products">
                    All Products
                </a>
                <a class="block w-full px-3 py-2 rounded-md font-semibold text-gray-700 hover:bg-gray-100" href="/owners/products/create">
                    Create New Product
                </a>
            </div>
        </div>

        <!-- Edit Form -->
        <main class="w-3/4 bg-white p-8 shadow ml-6 rounded-md">
            <div class="flex items-center justify-between mb-6 pb-2 border-b">
                <h2 class="text-2xl font-bold text-gray-800">Edit Product</h2>
                <a href="/owners/products" class="text-sm font-semibold text-gray-500 hover:text-gray-800">
                    &larr; Cancel & Back
                </a>
            </div>

            <form autocomplete="off" action="/owners/products/<%= product._id %>" method="POST" enctype="multipart/form-data">
                <div class="mb-6">
                    <h3 class="text-lg font-semibold mb-3 text-gray-700">Product Details</h3>

                    <div class="mb-4">
                        <label class="block mb-2 font-medium text-sm text-gray-700">Product Image (optional to replace)</label>
                        <% if (product.image) { %>
                            <div class="mb-3 flex items-center gap-4 p-3 bg-gray-50 rounded border w-fit">
                                <img class="h-16 w-16 object-cover rounded"
                                     src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
                                <span class="text-xs text-gray-500">Current Image</span>
                            </div>
                        <% } %>
                        <input name="image" type="file" class="py-2 px-3 border rounded text-sm text-gray-600">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Product Name</label>
                            <input name="name" type="text" value="<%= product.name %>" required
                                placeholder="Product Name" class="border p-2 rounded w-full">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Price (₹)</label>
                            <input name="price" type="number" value="<%= product.price %>" required
                                placeholder="Product Price" class="border p-2 rounded w-full">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Discount (₹)</label>
                            <input name="discount" type="number" value="<%= product.discount || 0 %>"
                                placeholder="Discount Price" class="border p-2 rounded w-full">
                        </div>
                    </div>
                </div>

                <div class="mb-6">
                    <h3 class="text-lg font-semibold mb-3 text-gray-700">Color Customization</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Background Color (Hex/Name)</label>
                            <input name="bgcolor" type="text" value="<%= product.bgcolor || '' %>"
                                placeholder="e.g. #f3f4f6" class="border p-2 rounded w-full">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Panel Color (Hex/Name)</label>
                            <input name="panelcolor" type="text" value="<%= product.panelcolor || '' %>"
                                placeholder="e.g. #ffffff" class="border p-2 rounded w-full">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Text Color (Hex/Name)</label>
                            <input name="textcolor" type="text" value="<%= product.textcolor || '' %>"
                                placeholder="e.g. #000000" class="border p-2 rounded w-full">
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-4 pt-4 border-t">
                    <input class="px-6 py-2.5 rounded bg-blue-600 hover:bg-blue-700 text-white font-semibold cursor-pointer transition"
                        type="submit" value="Save Changes">
                    <a href="/owners/products" class="px-5 py-2.5 rounded border text-gray-700 font-semibold hover:bg-gray-100 transition">
                        Cancel
                    </a>
                </div>
            </form>
        </main>
    </div>
</div>

<%- include('./partials/footer') %>
