<%- include('./partials/header') %>
   <div class="w-full min-h-screen flex flex-col items-center px-20 py-16 gap-8">

    <h1 class="text-3xl">Shopping Cart</h1>

    <div class="w-full rounded-md overflow-hidden shadow-md">

        <!-- Table Header -->
        <div class="w-full flex items-center px-6 py-4 bg-gray-100 text-lg font-semibold">
            <div class="w-2/5">Product</div>
            <div class="w-1/6 text-center">Price</div>
            <div class="w-1/6 text-center">Discount</div>
            <div class="w-1/6 text-center">Quantity</div>
            <div class="w-1/6 text-center">Subtotal</div>
            <div class="w-1/12 text-center">Action</div>
        </div>

        <!-- Product Rows -->
        <% if (user.cart && user.cart.length > 0) { %>
            <% user.cart.forEach(function(item) { %>
                <% if (item.product) { %>
                    <div class="w-full flex items-center px-6 py-4 border-b bg-[<%= item.product.bgcolor %>] text-[<%= item.product.textcolor %>]">

                        <div class="w-2/5 flex items-center gap-4">
                            <% if (item.product.image) { %>
                                <img class="h-16 w-16 object-cover rounded" src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>" alt="">
                            <% } %>
                            <h3 class="text-xl font-medium"><%= item.product.name %></h3>
                        </div>

                        <div class="w-1/6 text-center text-lg">₹<%= Number(item.product.price) %></div>

                        <div class="w-1/6 text-center text-lg">₹<%= Number(item.product.discount || 0) %></div>

                        <div class="w-1/6 flex items-center justify-center gap-2">
                            <form action="/cart/decrease/<%= item.product._id %>" method="POST">
                                <button type="submit" class="w-7 h-7 flex items-center justify-center bg-gray-200 text-gray-800 rounded font-bold hover:bg-gray-300">-</button>
                            </form>
                            <span class="px-2 text-lg font-medium"><%= item.quantity %></span>
                            <form action="/cart/increase/<%= item.product._id %>" method="POST">
                                <button type="submit" class="w-7 h-7 flex items-center justify-center bg-gray-200 text-gray-800 rounded font-bold hover:bg-gray-300">+</button>
                            </form>
                        </div>

                        <div class="w-1/6 text-center text-lg font-semibold">
                            ₹<%= (Number(item.product.price) - Number(item.product.discount || 0)) * item.quantity %>
                        </div>

                        <div class="w-1/12 text-center">
                            <form action="/cart/remove/<%= item.product._id %>" method="POST">
                                <button type="submit" class="px-3 py-1 bg-red-500 text-white rounded text-sm hover:bg-red-600">Remove</button>
                            </form>
                        </div>

                    </div>
                <% } %>
            <% }) %>
        <% } else { %>
            <div class="p-8 text-center text-gray-500">
                <p class="text-xl mb-4">Your cart is empty.</p>
                <a href="/shop" class="px-6 py-2 bg-blue-500 text-white rounded-full">Continue Shopping</a>
            </div>
        <% } %>

    </div>

    <div class="w-full flex flex-col items-end gap-3 mt-4">
        <div class="w-1/3 flex justify-between items-center px-6 py-4 rounded-md bg-[#3f2a1d] text-white">
            <h3 class="text-xl">Total Amount</h3>
            <h3 class="text-xl font-semibold text-green-400">₹<%= bill %></h3>
        </div>
        <% if (user.cart && user.cart.length > 0) { %>
            <a href="/orders/checkout"
               class="w-1/3 text-center py-3 bg-amber-600 hover:bg-amber-700 text-white rounded-md text-lg font-semibold shadow-md transition">
                Proceed to Checkout &rarr;
            </a>
        <% } %>
    </div>

</div>
    <%- include('./partials/footer') %>