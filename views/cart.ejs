<%- include('./partials/header') %>
   <div class="w-full min-h-screen flex flex-col items-center px-20 py-16 gap-8">

    <h1 class="text-3xl">Shopping Cart</h1>

    <div class="w-full rounded-md overflow-hidden shadow-md">

        <!-- Table Header -->
        <div class="w-full flex items-center px-6 py-4 bg-gray-100 text-lg font-semibold">
            <div class="w-1/2">Product</div>
            <div class="w-1/6 text-center">Price</div>
            <div class="w-1/6 text-center">Discount</div>
            <div class="w-1/6 text-center">Subtotal</div>
        </div>

        <!-- Product Rows -->
        <% user.cart.forEach(function(item) { %>
            <div class="w-full flex items-center px-6 py-4 border-b bg-[<%= item.bgcolor %>] text-[<%= item.textcolor %>]">

                <div class="w-1/2 flex items-center gap-4">
                    <img class="h-16 w-16 object-cover rounded" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="">
                    <h3 class="text-xl"><%= item.name %></h3>
                </div>

                <div class="w-1/6 text-center text-lg">₹<%= Number(item.price) %></div>

                <div class="w-1/6 text-center text-lg">₹<%= Number(item.discount) %></div>

                <div class="w-1/6 text-center text-lg font-semibold">₹<%= Number(item.price) - Number(item.discount) %></div>

            </div>
        <% }) %>

    </div>

    <div class="w-full flex justify-end">
        <div class="w-1/3 flex justify-between items-center px-6 py-4 rounded-md bg-[#3f2a1d] text-white mt-2">
            <h3 class="text-xl">Total Amount</h3>
            <h3 class="text-xl font-semibold text-green-400">₹<%= bill %></h3>
        </div>
    </div>

</div>
    <%- include('./partials/footer') %>